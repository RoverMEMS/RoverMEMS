    <!-- GaugeMetricInfo popups -->
    <string name="info_rpm_desc">Engine speed, in revolutions per minute.</string>
    <string name="info_rpm_range">Typical: around 750-1000 rpm at idle</string>
    <string name="info_map_desc">Pressure inside the intake manifold. Lower means more vacuum (throttle closed); closer to atmospheric (about 100kPa) means closer to wide-open throttle.</string>
    <string name="info_map_range">Typical: 25-45kPa at idle, 90kPa+ near wide-open throttle</string>
    <string name="info_tps_desc">Throttle position sensor voltage (accelerator opening).</string>
    <string name="info_tps_range">Typical: 0.3-0.7V with foot off the pedal, about 4.0V+ at wide open</string>
    <string name="info_coolant_desc">Engine coolant temperature. The conversion formula for this value (raw - 55) hasn\'t been verified yet, so a one-time check against the real car is recommended.</string>
    <string name="info_coolant_range">Typical: 80-105°C once warmed up. Well above that is a sign of overheating.</string>
    <string name="info_intake_desc">Temperature of the air drawn into the engine. Affected by outside air temperature plus engine heat.</string>
    <string name="info_intake_range">Typical: roughly outside air temp up to outside air temp + 30°C</string>
    <string name="info_battery_desc">Battery voltage. The typical range differs between engine off and running.</string>
    <string name="info_battery_range">Typical: 12.0-12.8V engine off, 13.5-14.8V running (charging)</string>
    <string name="info_ignition_desc">Ignition timing (how many degrees before top dead center it fires). Varies with rpm and load.</string>
    <string name="info_ignition_range">Typical: roughly 5-15° at idle</string>
    <string name="info_lambda_desc">O2 (oxygen) sensor voltage. Fine, continuous swings between 0-1000mV are normal while in closed-loop control.</string>
    <string name="info_lambda_range">Typical: swinging around an average of roughly 450mV</string>
    <string name="info_fuel_trim_desc">How much the ECU is correcting the base fuel injection amount. 100% is the "no correction" baseline.</string>
    <string name="info_fuel_trim_range">Typical: roughly 85-115%. Well outside that range suggests checking the fuel system or sensors.</string>

